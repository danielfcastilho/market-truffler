# Environment
.env
.env.*.local
!.env.example

# Python
apps/api/.venv/
apps/api/__pycache__/
apps/api/**/__pycache__/
apps/api/*.egg-info/
apps/api/.pytest_cache/
apps/api/.mypy_cache/
apps/api/.ruff_cache/

# Node / Next.js (apps/web has its own .gitignore too)
node_modules/

# OS
.DS_Store

# OINK CORP research datasets and experiment run records — large, never
# committed, and NOT regenerable once source data expires: back them up
# independently (see docs/ARCHITECTURE.md).
research/oink_corp/data/

# Local Compose overrides (e.g. the research backup mount — host-specific paths).
docker-compose.override.yml
