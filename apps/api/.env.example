# Only needed when running the API directly on the host (outside Docker
# Compose), e.g. `uvicorn app.main:app --reload`. Copy to `.env` in this
# directory. Docker Compose sets these itself — see the root .env.example.

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://truffler:truffler@localhost:5432/market_truffler
SESSION_SECRET=please-generate-a-long-random-value-before-first-run
SESSION_TTL_MINUTES=10080
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Optional — all already default to these values. Override only to point at
# a different environment (e.g. Bybit's testnet) or tune timeouts.
# BYBIT_BASE_URL=https://api.bybit.com
# BYBIT_TIMEOUT_SECONDS=5.0
# BYBIT_WS_BASE_URL=wss://stream.bybit.com/v5/public/linear

# Optional — MARKET's historical bootstrap/retention tuning. All already
# default to these values; override only for a deliberately shorter/faster
# local setup or to tune REST concurrency against Bybit's rate limits.
# MARKET_HISTORY_RETENTION_DAYS=365
# MARKET_HISTORY_MAX_CONCURRENT_INSTRUMENTS=5
# MARKET_HISTORY_PAGE_SIZE=1000
# MARKET_HISTORY_REQUEST_DELAY_SECONDS=0.2
# MARKET_HISTORY_CATCHUP_BUFFER_MINUTES=2
# MARKET_UNIVERSE_REFRESH_INTERVAL_SECONDS=900.0

# Optional — how long the frame synchronizer waits after each UTC minute
# boundary for normal WebSocket delivery to settle before finalizing that
# minute's Market Frame.
# MARKET_FRAME_GRACE_PERIOD_SECONDS=5.0
