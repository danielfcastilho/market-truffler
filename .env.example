# Market Truffler — environment configuration
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is read by `docker compose` and is git-ignored. Never commit real
# secrets. No Bybit/exchange credentials belong here — this milestone does
# not talk to any exchange.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
# Used to build the API's DATABASE_URL and to initialize the postgres
# container on first boot. Postgres is not exposed to the host; only
# containers on the internal docker-compose network can reach it.
POSTGRES_USER=truffler
POSTGRES_PASSWORD=truffler
POSTGRES_DB=market_truffler

# --- Auth / sessions ---
# Secret used to sign session tokens. Required — the API refuses to start
# without it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=please-generate-a-long-random-value-before-first-run
SESSION_TTL_MINUTES=10080

# --- Frontend / CORS ---
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# --- Ports exposed on the host ---
API_PORT=8000
WEB_PORT=3000
